#!/usr/bin/env python3
"""rcoi-tui - a terminal UI for rcoi tasks and git agent branches.

usage: rcoi-tui [-a|--all] [--interval SECONDS] [--no-mux]

Run it inside a repo on your machine: it shows that repo's tasks on the agent
host (rcoi task list) next to their agent/<task> branches (git agent), with a
live view of the selected agent's screen. R picks another repo, A switches
between one repo and all of them; outside a repo, or with --all, it starts
with all of them.

It is a front end only: every action runs rcoi or git agent, and the command
it runs is shown in the output log (o). git agent runs in the repo's local
clone (new syncs main first; done and drop also remove review/<task> there).
Clones are found by their agentvm remote, one or two levels below the folders
in RCOI_TUI_ROOTS (colon-separated; default: ~/Projects, ~/src, ~/code and the
folder holding the current repo). For a repo without a clone the git actions
are off, and new/done/drop use rcoi task.

  --all          start with the tasks of every repo
  --interval N   refresh the selected agent's screen every N seconds (default 2)
  --no-mux       don't share one SSH connection between commands

Keys (? inside the UI shows them too):
  j/k, arrows    select                    v, Space   the agent's screen, whole window
  Tab            its changes (commits, diffstat), whole window
  R              pick a repo               A          one repo / all repos
  Enter, a       attach (Ctrl+B, d)        n          new task (--bg, optional prompt)
  s              send text to the agent    u          start a session (restarts a dead one)
  x              stop the session          w          the agent's uncommitted changes
  c              commit them on the host   d / l      diff / log in your pager
  t              try (review/<task>)       p / P      pull / push review/<task>
  U              update review/<task> with main, then push it
  m              merge into main           D          done (merged only)
  X              drop (discards the work)  y          sync main to the host
  r              refresh now               o          output of past commands
  q              quit

AGENT is what the agent is doing (coi-task reads its screen, Claude or Codex):
  working    busy                    waiting   its turn ended: done, or wants a reply
  asking     a question or approval on screen: attach (Enter) to answer
  no agent   the container runs but the agent's tmux session is gone
             (it exited, or killed its tmux server): u restarts it
  starting, stopped, frozen          (frozen: paused by Coi's monitor)
WIP is the number of uncommitted files in its worktree on the host (w shows
them, c commits them). With an older coi-task on the host, AGENT shows the
session state only (running): update it with ./install.sh.
"""
import curses
import locale
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time

HERE = os.path.dirname(os.path.realpath(__file__))
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "rcoi", "host")
REMOTE = os.environ.get("AGENTVM_REMOTE", "agentvm")
BASE = os.environ.get("AGENTVM_BASE", "main")
LIST_INTERVAL = 15          # seconds between full refreshes
STATUS_SECS = float(os.environ.get("RCOI_TUI_STATUS_SECS", 8))   # how long "done" messages stay (errors stay until a key is pressed)
NAME_RE = re.compile(r"^[A-Za-z0-9._-]+$")


def tool(name, fallback):
    """The script installed next to this one (same version), else from PATH."""
    p = os.path.join(HERE, name)
    return [p] if os.access(p, os.X_OK) else fallback


RCOI = tool("rcoi", ["rcoi"])
GIT_AGENT = tool("git-agent", ["git", "agent"])


def valid_name(s):
    return bool(NAME_RE.match(s)) and not s.startswith(".")


def run(cmd, cwd=None, timeout=None):
    """Run cmd without a terminal; returns (exit code, stdout+stderr)."""
    try:
        p = subprocess.run(cmd, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                           stderr=subprocess.STDOUT, timeout=timeout)
    except FileNotFoundError as e:
        return 127, str(e)
    except subprocess.TimeoutExpired:
        return 124, "timed out: " + " ".join(cmd)
    return p.returncode, p.stdout.decode("utf-8", "replace")


def git(*args, cwd=None):
    return run(["git"] + list(args), cwd=cwd)


def git_out(*args, cwd=None):
    rc, out = git(*args, cwd=cwd)
    return out.strip() if rc == 0 else ""


def host_repo(path):
    """The repo's name on the agent host (its agentvm remote is host:src/<name>), or ""."""
    url = git_out("remote", "get-url", REMOTE, cwd=path)
    name = os.path.basename(url.split(":", 1)[-1].rstrip("/")) if url else ""
    return name[:-4] if name.endswith(".git") else name


def roots(here_top):
    """Folders to look for local clones in: RCOI_TUI_ROOTS (colon-separated),
    else ~/Projects, ~/src, ~/code and the folder the current repo is in."""
    env = os.environ.get("RCOI_TUI_ROOTS")
    if env is not None:
        dirs = [os.path.expanduser(d) for d in env.split(":") if d]
    else:
        dirs = [os.path.expanduser(d) for d in ("~/Projects", "~/src", "~/code")]
        if here_top:
            dirs.insert(0, os.path.dirname(here_top))
    seen, out = set(), []
    for d in dirs:
        d = os.path.realpath(d)
        if d not in seen and os.path.isdir(d):
            seen.add(d)
            out.append(d)
    return out


def find_clones(dirs, here_top=None):
    """{host repo name: local path} for the repos with an agentvm remote,
    one or two levels below each of dirs. The current repo wins a tie."""
    found = {}
    cands = [here_top] if here_top else []
    for d in dirs:
        for sub in sorted(os.listdir(d)):
            p = os.path.join(d, sub)
            if not os.path.isdir(p) or sub.startswith("."):
                continue
            if os.path.exists(os.path.join(p, ".git")):
                cands.append(p)
                continue
            try:
                cands += [os.path.join(p, s) for s in sorted(os.listdir(p))
                          if os.path.exists(os.path.join(p, s, ".git"))]
            except OSError:
                pass
    for p in cands:
        name = host_repo(p)
        if name and name not in found:
            found[name] = p
    return found


def compare_base(path, local):
    """Local main vs the host's main: (same|ahead|behind|diverged|unknown, note)."""
    rc, out = git("ls-remote", "-q", REMOTE, "refs/heads/" + BASE, cwd=path)
    host = out.split()[0] if rc == 0 and out.strip() else ""
    if not host:
        return "unknown", "no %s on the agent host" % BASE
    if not local:
        return "unknown", "no local %s" % BASE
    if host == local:
        return "same", "%s in sync" % BASE
    known = git("cat-file", "-e", host + "^{commit}", cwd=path)[0] == 0
    if known and git("merge-base", "--is-ancestor", host, local, cwd=path)[0] == 0:
        n = git_out("rev-list", "--count", "%s..%s" % (host, local), cwd=path)
        return "ahead", "%s: %s commit(s) not on the host (y: sync)" % (BASE, n)
    if known and git("merge-base", "--is-ancestor", local, host, cwd=path)[0] == 0:
        return "behind", "%s is behind the host's" % BASE
    return "diverged", "%s differs from the host's" % BASE


# The agents' own interface on their screen (boxes, prompts, footers, key hints),
# skipped when picking out what an agent last said.
CHROME_RE = re.compile(
    r"^[\s─━═╭╮╰╯│┃▐▛▜▝▘█▌❯>›·•]*$"
    r"|bypass permissions|for shortcuts|shift\+tab|context left|⏎ send|Ask Codex"
    r"|Enter to (select|confirm)|Esc to cancel|to navigate|Type something|Chat about this"
    r"|^\d[\d,.]*k? tokens$|disable recaps"
    r"|^\S \w+ed for \d+[hms]",          # Claude's turn footer: "✻ Cooked for 3s · done 8:11 PM"
    re.I)


def excerpt(lines, asking=False, n=2):
    """What the agent last said, from its screen: the question when it's asking,
    else the last n lines of real output."""
    real = [l for l in (l.strip() for l in lines) if l and not CHROME_RE.search(l)]
    if asking:
        q = [l for l in real[-25:] if l.endswith("?")]
        if q:
            return [q[-1]]
    return real[-n:]


# What `coi tmux capture` says when the container runs but its tmux session doesn't.
NO_TMUX_RE = re.compile(r"can't find session|no tmux session|no server running|error connecting to", re.I)
CTRL_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|[\x00-\x08\x0b-\x1f\x7f]")


def clean(line):
    return CTRL_RE.sub("", line.replace("\t", "    ").rstrip("\r\n"))


def shown(cmd):
    """A command as the user would type it (for the output log)."""
    import shlex
    words = list(cmd)
    if words[:1] == RCOI:
        words[0] = "rcoi"
    elif words[:1] == GIT_AGENT[:1] and GIT_AGENT != ["git", "agent"]:
        words[:1] = ["git", "agent"]
    return " ".join(shlex.quote(w) for w in words)


class Task:
    def __init__(self, repo, name):
        self.repo = repo
        self.name = name
        self.worktree = ""      # path on the agent host, "" if none
        self.profile = ""
        self.sessions = []      # [(container, status)]
        self.ref = ""           # refs/remotes/agentvm/agent/<name> here, if fetched
        self.updated = ""       # committer date, relative
        self.subject = ""
        self.ahead = None       # commits not in local main
        self.behind = None
        self.agent = ""         # what the agent is doing (coi-task list): working, waiting, asking, ...
        self.uncommitted = None # files changed in the host's worktree, if known
        self.work = ""          # coi-task list's "+4 commits, 3 uncommitted"
        self.review = False     # review/<name> exists in the clone
        self.clone = ""         # local clone of the repo ("" if none found)
        self.gone = False       # container up, agent's tmux session gone

    @property
    def key(self):
        return (self.repo, self.name)

    @property
    def session(self):
        """The live container (running or frozen), else None."""
        for ct, st in self.sessions:
            if st in ("running", "frozen"):
                return ct, st
        return None

    @property
    def state(self):
        s = self.session
        if s:
            if self.gone or self.agent == "no agent":
                return "no agent"
            if s[1] == "running" and self.agent and self.agent != "unknown":
                return self.agent
            return s[1]
        if self.worktree:
            return "stopped"
        return "no worktree"


def parse_task_list(text):
    """Parse `coi-task list` output into ({key: Task}, [repos])."""
    tasks, repos = {}, []
    for raw in text.splitlines():
        line = raw.rstrip()
        if not line.startswith("/"):
            continue
        path = line.split()[0]
        m = re.search(r"\[([^\]]+)\]", line)
        branch = m.group(1) if m else ""
        base = os.path.basename(path)
        if not branch.startswith("agent/"):
            repos.append(base)          # the repo itself (its first worktree)
            continue
        name = branch[len("agent/"):]
        repo = base[: -len(name) - 1] if base.endswith("-" + name) else base
        t = Task(repo, name)
        t.worktree = path
        # The rest is "   key: value" fields (older coi-task: profile, session only).
        fields = dict(f.split(": ", 1) for f in re.split(r"\s{3,}", line) if re.match(r"^[a-z]+: ", f))
        t.profile = fields.get("profile", "").strip()
        for part in fields.get("session", "").split(", "):
            bits = part.split()
            if len(bits) >= 2:
                t.sessions.append((bits[0], bits[1]))
        t.agent = fields.get("agent", "").strip()
        t.work = fields.get("work", "").strip()
        m = re.search(r"(\d+) uncommitted", fields.get("work", ""))
        t.uncommitted = int(m.group(1)) if m else (0 if "clean" in fields.get("work", "") else None)
        tasks[t.key] = t
    return tasks, repos


class Model:
    """State shared between the UI thread and the background fetchers."""

    def __init__(self, host, here, clones, all_repos):
        self.lock = threading.Lock()
        self.host = host
        self.here = here                # the host repo name of the folder we started in, or None
        self.clones = clones            # host repo name -> local clone (with the agentvm remote)
        self.view = None if (all_repos or not here) else here   # repo shown, None: all
        self.tasks = []                 # every repo's tasks; visible() filters by view
        self.repos = []                 # repos on the host, and ones with a local clone
        self.bases = {}                 # repo -> (state, note): local main vs the host's
        self.list_error = ""
        self.old_host = False           # coi-task on the host reports no agent states (too old)
        self.refreshing = False
        self.refreshed_at = 0.0
        self.screens = {}               # key -> (time, [lines])
        self.dead = {}                  # key -> container whose agent's tmux session is gone
        self.changes = {}               # (key, sha) -> [lines]
        self.action = None              # label of the running action
        self.status = ""
        self.status_ok = True
        self.log = []                   # output of every action
        self.wake_list = threading.Event()
        self.wake_peek = threading.Event()
        self.selected = None            # key of the selected task (set by the UI)
        self.preview_lines = 40         # screen lines to fetch (more in the full view)
        self.preview = "screen"         # full view: "screen" or "changes"

    def visible(self):
        return [t for t in self.tasks if self.view is None or t.repo == self.view]

    # ---------------------------------------------------------------- refresh
    def refresh(self):
        with self.lock:
            self.refreshing = True
        # Always every repo: switching the view (A, R) is then instant.
        rc, out = run(RCOI + ["task", "list"], timeout=60)
        tasks, repos = parse_task_list(out) if rc == 0 else ({}, [])
        err = "" if rc == 0 else (clean(out.strip().splitlines()[-1]) if out.strip() else "rcoi task list failed")

        bases = {}
        for repo, path in sorted(self.clones.items()):
            git("fetch", "-q", "--prune", REMOTE, cwd=path)
            fmt = "%(refname:lstrip=4)%09%(committerdate:relative)%09%(subject)"
            refs = git_out("for-each-ref", "--sort=-committerdate", "--format=" + fmt,
                           "refs/remotes/%s/agent/" % REMOTE, cwd=path)
            local_base = git_out("rev-parse", "-q", "--verify", "refs/heads/" + BASE, cwd=path)
            for line in refs.splitlines():
                name, updated, subject = (line.split("\t", 2) + ["", ""])[:3]
                t = tasks.get((repo, name))
                if t is None:
                    t = tasks[(repo, name)] = Task(repo, name)
                t.ref = "refs/remotes/%s/agent/%s" % (REMOTE, name)
                t.updated, t.subject = updated, subject
                if local_base:
                    counts = git_out("rev-list", "--left-right", "--count",
                                     "%s...%s" % (local_base, t.ref), cwd=path).split()
                    if len(counts) == 2:
                        t.behind, t.ahead = int(counts[0]), int(counts[1])
            bases[repo] = compare_base(path, local_base)
            for name in git_out("for-each-ref", "--format=%(refname:lstrip=3)", "refs/heads/review/", cwd=path).split():
                t = tasks.get((repo, name))
                if t is not None:
                    t.review = True
        for t in tasks.values():
            t.clone = self.clones.get(t.repo, "")

        order = sorted(tasks.values(), key=lambda t: (t.repo != self.here, t.repo, t.session is None, t.name))
        with self.lock:
            for t in order:
                t.gone = bool(t.session) and self.dead.get(t.key) == t.session[0]
            self.tasks = order
            self.repos = sorted(set(repos) | set(self.clones))
            self.list_error = err
            # A newer coi-task adds "work:" to every task line; none at all means an old one.
            self.old_host = rc == 0 and bool(tasks) and not any("   work: " in l for l in out.splitlines())
            self.bases = bases
            self.refreshing = False
            self.refreshed_at = time.time()

    def changes_for(self, t):
        sha = git_out("rev-parse", "-q", "--verify", t.ref, cwd=t.clone) if t.ref and t.clone else ""
        key = (t.key, sha)
        if key in self.changes:
            return self.changes[key]
        if not t.clone:
            lines = ["(no local clone of %s found - see RCOI_TUI_ROOTS in ?)" % t.repo]
        elif not sha:
            lines = ["(no agent/%s branch fetched in %s)" % (t.name, t.clone)]
        else:
            log = git_out("log", "--format=%h %s (%cr)", "%s..%s" % (BASE, sha), cwd=t.clone)
            stat = git_out("diff", "--stat", "%s...%s" % (BASE, sha), cwd=t.clone)
            lines = ["commits not in %s:" % BASE] + (log.splitlines() or ["  (none)"])
            lines += [""] + (stat.splitlines() or ["(no changes)"])
        self.changes[key] = lines
        return lines

    # -------------------------------------------------------------- loops
    def list_loop(self):
        while True:
            try:
                self.refresh()
            except Exception as e:      # keep the UI alive; show what broke
                with self.lock:
                    self.refreshing = False
                    self.list_error = "refresh failed: %s" % e
            self.wake_list.wait(LIST_INTERVAL)
            self.wake_list.clear()

    def peek_loop(self, interval):
        while True:
            with self.lock:
                key, n = self.selected, self.preview_lines
                t = next((x for x in self.tasks if x.key == key), None)
            if t is not None and t.session:
                ct = t.session[0]
                rc, out = run(RCOI + ["task", "peek", t.repo, t.name, str(max(n, 5))], timeout=30)
                lines = [clean(l) for l in out.splitlines()]
                gone = bool(NO_TMUX_RE.search(out))
                if gone:
                    lines = ["(the container %s is running, but the agent's tmux session is gone:" % ct,
                             " it exited, or something in it killed the tmux server)", "",
                             "u: restart it (stop + start; the worktree and commits stay)"]
                elif rc != 0 and not lines:
                    lines = ["(peek failed, exit %d)" % rc]
                elif rc != 0:
                    lines = ["(peek failed)"] + lines[-3:]
                with self.lock:
                    self.screens[key] = (time.time(), lines)
                    if gone:
                        self.dead[key] = ct
                    elif self.dead.get(key) == ct:
                        del self.dead[key]
                    t.gone = gone
            self.wake_peek.wait(interval)
            self.wake_peek.clear()

    # -------------------------------------------------------------- actions
    def start_action(self, label, cmds, cwd=None):
        """Run cmds one after another in the background (stop at the first failure),
        in cwd (a repo's clone, for git agent)."""
        with self.lock:
            if self.action:
                self.status, self.status_ok = "busy: %s" % self.action, False
                return
            self.action = label
            self.status, self.status_ok = label + " ...", True
        threading.Thread(target=self._action, args=(label, cmds, cwd), daemon=True).start()

    def _action(self, label, cmds, cwd):
        ok, last = True, ""
        for cmd in cmds:
            rc, out = run(cmd, cwd=cwd)
            lines = [clean(l) for l in out.splitlines()]
            with self.lock:
                self.log.append(("(%s) " % cwd if cwd else "") + "$ " + shown(cmd)
                                + ("" if rc == 0 else "   [exit %d]" % rc))
                self.log.extend("  " + l for l in lines)
            last = next((l for l in reversed(lines) if l.strip()), "")
            if rc != 0:
                ok = False
                break
        with self.lock:
            self.action = None
            self.status_ok = ok
            self.status = ("%s: done" % label if ok else "%s failed" % label) + (" - " + last if last else "") + "  (o: output)"
            self.changes.clear()
        self.wake_list.set()
        self.wake_peek.set()


