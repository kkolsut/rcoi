class UI:
    def __init__(self, scr, model, interval):
        self.scr = scr
        self.m = model
        self.sel = 0
        self.top = 0
        self.interval = interval
        self.shown_status, self.status_since = "", 0.0
        curses.curs_set(0)
        scr.keypad(True)
        scr.timeout(250)
        self.colors = {}
        if curses.has_colors():
            curses.start_color()
            try:
                curses.use_default_colors()
                bg = -1
            except curses.error:
                bg = curses.COLOR_BLACK
            for i, (name, fg) in enumerate([("running", curses.COLOR_GREEN), ("frozen", curses.COLOR_CYAN),
                                            ("warn", curses.COLOR_YELLOW), ("err", curses.COLOR_RED),
                                            ("dim", curses.COLOR_BLUE)], 1):
                curses.init_pair(i, fg, bg)
                self.colors[name] = curses.color_pair(i)
            # Key caps in the menu: dark on cyan (htop/nano style).
            curses.init_pair(9, curses.COLOR_BLACK, curses.COLOR_CYAN)
            self.colors["key"] = curses.color_pair(9) | curses.A_BOLD

    def c(self, name):
        return self.colors.get(name, 0)

    def state_attr(self, state):
        """How an AGENT state looks: waiting and asking stand out - your turn."""
        return {"working": self.c("running"), "running": self.c("running"), "starting": self.c("running"),
                "waiting": self.c("frozen") | curses.A_BOLD, "asking": self.c("warn") | curses.A_BOLD,
                "no agent": self.c("err") | curses.A_BOLD, "frozen": self.c("frozen")}.get(state, self.c("dim"))

    # -------------------------------------------------------------- drawing
    def put(self, y, x, text, attr=0, width=None):
        h, w = self.scr.getmaxyx()
        if y < 0 or y >= h or x >= w:
            return
        n = (w - x) if width is None else min(width, w - x)
        if y == h - 1:
            n -= 1          # writing the bottom-right cell raises an error
        if n <= 0:
            return
        try:
            self.scr.addnstr(y, x, text, n, attr)
        except curses.error:
            pass

    def current(self):
        tasks = self.m.visible()
        if not tasks:
            return None
        self.sel = max(0, min(self.sel, len(tasks) - 1))
        return tasks[self.sel]

    def draw(self, prompt=None):
        m, scr = self.m, self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        with m.lock:
            tasks = m.visible()
            cur = self.current()
            m.selected = cur.key if cur else None
            # header
            where = "all repos" if m.view is None else "repo: %s" % m.view
            spin = "   refreshing..." if m.refreshing else ""
            head = " rcoi-tui   %s   host: %s%s" % (where, m.host or "<not set>", spin)
            self.put(0, 0, head.ljust(w), curses.A_REVERSE | curses.A_BOLD)
            # main vs the host's, for the repo in view (or the selected task's)
            repo = m.view or (cur.repo if cur else None)
            note, attr = "", 0
            if repo:
                if repo in m.clones:
                    state, note = m.bases.get(repo, ("", ""))
                    note = ("%s: " % repo if m.view is None else "") + note if note else ""
                    if state in ("ahead", "behind", "diverged", "unknown"):
                        attr = self.c("warn")
                elif m.refreshed_at:
                    note, attr = ("%s: no local clone found (git actions off; RCOI_TUI_ROOTS, see ?)" % repo,
                                  self.c("warn"))
            if m.old_host:
                note, attr = ("coi-task on the host is too old to show what agents are doing "
                              "(AGENT says running): update it with ./install.sh", self.c("warn"))
            if m.list_error:
                note, attr = m.list_error, self.c("err")
            self.put(1, 1, note, attr)

            # task table
            show_repo = m.view is None
            cols = [("TASK", 18), ("AGENT", 9), ("WIP", 4), ("PROFILE", 10), ("+/-", 7), ("REVIEW", 6), ("UPDATED", 16)]
            if show_repo:
                cols.insert(0, ("REPO", 14))
            # rows: 0-1 header, 2 column titles, then tasks down to the details
            # panel (a rule + 3 lines) above the status line and the keys
            panel_y = h - 6
            table_h = max(2, panel_y - 2)
            y = 2
            x = 1
            for title, cw in cols:
                self.put(y, x, title, curses.A_BOLD)
                x += cw + 1
            self.put(y, x, "LAST COMMIT", curses.A_BOLD)
            rows = table_h - 1
            if self.sel < self.top:
                self.top = self.sel
            elif self.sel >= self.top + rows:
                self.top = self.sel - rows + 1
            if not tasks:
                msg = "no tasks yet - n: new task, R: other repos" if m.refreshed_at else "loading..."
                self.put(y + 1, 2, msg, self.c("dim"))
            for i, t in enumerate(tasks[self.top:self.top + rows]):
                idx = self.top + i
                ry = y + 1 + i
                sel = idx == self.sel
                base_attr = curses.A_REVERSE if sel else 0
                if sel:
                    self.put(ry, 0, " " * w, base_attr)
                ahead = "" if t.ahead is None else "+%d" % t.ahead + ("/-%d" % t.behind if t.behind else "")
                wip = "" if not t.uncommitted else str(t.uncommitted)
                vals = [t.name, t.state, wip, t.profile or "-", ahead, "yes" if t.review else "", t.updated or "-"]
                if show_repo:
                    vals.insert(0, t.repo)
                x = 1
                for (title, cw), v in zip(cols, vals):
                    a = base_attr
                    if title == "AGENT":
                        a |= self.state_attr(t.state)
                    elif title == "WIP" and t.uncommitted:
                        a |= self.c("warn")
                    self.put(ry, x, v[:cw], a, cw)
                    x += cw + 1
                self.put(ry, x, t.subject, base_attr)

            # details of the selected task
            self.put(panel_y, 0, "─" * w, self.c("dim"))
            if cur is not None:
                self.draw_details(panel_y + 1, w, cur)

            # status line (or a rule), then the keys - always shown unless prompting
            st = self.status_text()
            if st:
                self.put(h - 2, 0, " " + st, curses.A_BOLD if m.status_ok else self.c("err") | curses.A_BOLD)
            else:
                self.put(h - 2, 0, "─" * w, self.c("dim"))
            if prompt is None:
                self.draw_keys(h - 1, w, self.menu(cur))
        if prompt is not None:
            label, text, pos = prompt
            room = w - len(label) - 3
            start = max(0, pos - room + 1) if room > 0 else 0
            self.put(h - 1, 1, label, curses.A_BOLD)
            self.put(h - 1, 1 + len(label), text[start:start + room])
            try:
                curses.curs_set(1)
                scr.move(h - 1, min(w - 2, 1 + len(label) + pos - start))
            except curses.error:
                pass
        scr.refresh()

    def menu(self, t):
        """(key, label) pairs for the bottom line, most useful first; only the keys
        that do something for the selected task t (all keys: ?)."""
        m = self.m
        items = []
        if t is not None:
            if t.gone or t.state == "no agent":
                items += [("u", "restart")]
            elif t.state == "asking":
                items += [("⏎", "answer"), ("v", "view"), ("s", "send"), ("x", "stop")]
            elif t.session:
                items += [("v", "view"), ("⏎", "attach"), ("s", "send"), ("x", "stop")]
            elif t.worktree:
                items += [("u", "start"), ("⏎", "shell")]
            if t.clone and t.ref:
                items += [("d", "diff"), ("t", "try"), ("m", "merge")]
                if t.review:
                    items += [("p", "pull"), ("P", "push")]
            if t.worktree:
                items += [("w", "wip")]
            items += [("X", "drop")]
        items += [("n", "new"), ("R", "repo"), ("A", "one repo" if m.view is None else "all repos"),
                  ("o", "output")]
        return items

    def draw_keys(self, y, w, items, tail=(("?", "help"), ("q", "quit"))):
        """The menu: highlighted keys and their labels; what doesn't fit is
        dropped from the end, but the tail ("? help  q quit") stays at the right."""
        tail = list(tail)
        width = lambda its: sum(len(k) + len(l) + 4 for k, l in its)
        room = w - 1 - width(tail)
        shown_items = []
        for it in items:
            if width(shown_items + [it]) > room:
                break
            shown_items.append(it)
        x = 0
        for k, label in shown_items:
            self.put(y, x, " %s " % k, self.c("key") or curses.A_REVERSE)
            self.put(y, x + len(k) + 2, label)
            x += len(k) + len(label) + 4
        x = max(x, w - 1 - width(tail))
        for k, label in tail:
            self.put(y, x, " %s " % k, self.c("key") or curses.A_REVERSE)
            self.put(y, x + len(k) + 2, label)
            x += len(k) + len(label) + 4

    def draw_details(self, y, w, t):
        """Three lines about task t: what it is and does, then what the agent last said."""
        m = self.m
        bits = [t.name if m.view else "%s/%s" % (t.repo, t.name)]
        self.put(y, 1, bits[0], curses.A_BOLD)
        x = 1 + len(bits[0])
        for text, attr in [(t.state, self.state_attr(t.state)),
                           (t.session[0] if t.session else "", self.c("dim")),
                           (t.work, 0)]:
            if text:
                self.put(y, x, "  ·  ", self.c("dim"))
                self.put(y, x + 5, text, attr)
                x += 5 + len(text)
        if t.gone or t.state == "no agent":
            lines = ["the agent's tmux session is gone (it exited, or killed the tmux server)",
                     "u: restart it (stop + start; the worktree and commits stay)"]
        elif t.session:
            got = m.screens.get(t.key)
            lines = excerpt(got[1], t.state == "asking") if got else ["(loading the agent's screen...)"]
            lines = lines or ["(nothing on the agent's screen yet)"]
            if t.session[1] == "frozen":
                lines = ["paused by Coi's monitor (rcoi unfreeze %s)" % t.session[0]]
        elif t.worktree:
            lines = ["no session: u starts one, Enter an interactive one",
                     "last commit: %s" % t.subject if t.subject else ""]
        else:
            lines = ["no worktree on the host (task done or dropped)"]
        for i, l in enumerate(lines[:2]):
            if l:
                self.put(y + 1 + i, 1, "› " + l, curses.A_BOLD if t.state == "asking" else 0)

    def screen_view(self, t, mode=None):
        """The agent's screen in the whole window, live (Tab: its changes instead)."""
        m = self.m
        with m.lock:
            m.preview = mode or ("screen" if t.session else "changes")
        top = 0
        try:
            while True:
                h, w = self.scr.getmaxyx()
                body = h - 2
                with m.lock:
                    m.selected, m.preview_lines = t.key, max(body, 5)
                    mode = m.preview
                    t = next((x for x in m.tasks if x.key == t.key), t)
                    if mode == "screen":
                        got = m.screens.get(t.key)
                        lines = got[1] if got else ["(loading the agent's screen...)"]
                        lines = lines[-body:]
                    else:
                        lines = m.changes_for(t)
                self.scr.erase()
                title = " %s · %s · %s " % (t.name, t.state,
                                            "live screen (every %gs)" % self.interval if mode == "screen"
                                            else "changes: agent/%s vs %s" % (t.name, BASE))
                self.put(0, 0, title.ljust(w), curses.A_REVERSE | curses.A_BOLD)
                if mode == "changes":
                    top = max(0, min(top, len(lines) - body))
                    lines = lines[top:]
                for i, l in enumerate(lines[:body]):
                    self.put(1 + i, 1, l)
                self.draw_keys(h - 1, w, [("Tab", "changes" if mode == "screen" else "screen"),
                                          ("⏎", "attach"), ("s", "send")], tail=[("Esc", "back")])
                self.scr.refresh()
                try:
                    ch = self.scr.get_wch()
                except curses.error:
                    continue
                if ch in ("\x1b", "q", "v", " "):
                    return
                if ch == "\t":
                    with m.lock:
                        m.preview = "changes" if m.preview == "screen" else "screen"
                    top = 0
                    m.wake_peek.set()
                elif ch in ("\n", "\r", curses.KEY_ENTER, "a"):
                    self.act_attach(t)
                elif ch == "s":
                    self.act_send(t)
                elif mode == "changes":
                    top += {"j": 1, curses.KEY_DOWN: 1, "k": -1, curses.KEY_UP: -1,
                            curses.KEY_NPAGE: body, curses.KEY_PPAGE: -body}.get(ch, 0)
        finally:
            with m.lock:
                m.preview_lines = 40
            m.wake_peek.set()

    def status_text(self):
        """The status to show: while an action runs, with its time; a finished
        one for STATUS_SECS; an error until the next key (see loop)."""
        m, now = self.m, time.time()
        if m.status != self.shown_status:
            self.shown_status, self.status_since = m.status, now
        if m.action:
            return "[running %ds] %s" % (now - self.status_since, m.status)
        if m.status and m.status_ok and now - self.status_since > STATUS_SECS:
            m.status = self.shown_status = ""
        return m.status

    # -------------------------------------------------------------- input
    def ask(self, label, initial=""):
        """One line of input in the status line; None if cancelled (Esc)."""
        buf, pos = list(initial), len(initial)
        try:
            while True:
                self.draw(prompt=(label, "".join(buf), pos))
                try:
                    ch = self.scr.get_wch()
                except curses.error:
                    continue
                if ch in ("\n", "\r", curses.KEY_ENTER):
                    return "".join(buf)
                if ch in ("\x1b", "\x07"):              # Esc, Ctrl+G
                    return None
                if ch in ("\x7f", "\b", curses.KEY_BACKSPACE):
                    if pos:
                        del buf[pos - 1]
                        pos -= 1
                elif ch == curses.KEY_DC:
                    if pos < len(buf):
                        del buf[pos]
                elif ch == curses.KEY_LEFT:
                    pos = max(0, pos - 1)
                elif ch == curses.KEY_RIGHT:
                    pos = min(len(buf), pos + 1)
                elif ch in (curses.KEY_HOME, "\x01"):
                    pos = 0
                elif ch in (curses.KEY_END, "\x05"):
                    pos = len(buf)
                elif ch == "\x15":                      # Ctrl+U
                    del buf[:pos]
                    pos = 0
                elif isinstance(ch, str) and ch.isprintable():
                    buf.insert(pos, ch)
                    pos += 1
        finally:
            curses.curs_set(0)

    def confirm(self, question):
        a = self.ask(question + " [y/N] ")
        return a is not None and a.strip().lower() in ("y", "yes")

    def notify(self, text, ok=False):
        with self.m.lock:
            self.m.status, self.m.status_ok = text, ok

    def view(self, title, lines, follow=False):
        """Full-screen scrollable text (help, output log)."""
        top = None
        while True:
            h, w = self.scr.getmaxyx()
            body = h - 2
            last = max(0, len(lines) - body)
            if top is None:
                top = last if follow else 0
            top = max(0, min(top, last))
            self.scr.erase()
            self.put(0, 0, (" %s " % title).ljust(w), curses.A_REVERSE | curses.A_BOLD)
            for i, l in enumerate(lines[top:top + body]):
                self.put(1 + i, 1, l)
            self.put(h - 1, 1, "j/k space/b g/G scroll   q/Esc back", self.c("dim"))
            self.scr.refresh()
            try:
                ch = self.scr.get_wch()
            except curses.error:
                continue
            if ch in ("q", "\x1b", "\n", "\r", curses.KEY_ENTER):
                return
            top += {"j": 1, curses.KEY_DOWN: 1, "k": -1, curses.KEY_UP: -1, " ": body, curses.KEY_NPAGE: body,
                    "b": -body, curses.KEY_PPAGE: -body, "g": -len(lines), curses.KEY_HOME: -len(lines),
                    "G": len(lines), curses.KEY_END: len(lines)}.get(ch, 0)

    def interactive(self, cmd, pause=False, cwd=None):
        """Hand the terminal to cmd (attach, pagers), then come back."""
        curses.def_prog_mode()
        curses.endwin()
        print(("(%s) " % cwd if cwd else "") + "$ " + shown(cmd), flush=True)
        try:
            rc = subprocess.call(cmd, cwd=cwd)
        except FileNotFoundError as e:
            rc = 127
            print(e)
        if pause or rc != 0:
            try:
                input("[exit %d] press Enter to go back " % rc)
            except EOFError:
                pass
        curses.reset_prog_mode()
        self.scr.refresh()
        self.m.wake_list.set()
        self.m.wake_peek.set()
        return rc

    # -------------------------------------------------------------- actions
    def need_task(self):
        t = self.current()
        if t is None:
            self.notify("no task selected")
        return t

    def need_local(self, t):
        if not t.clone:
            self.notify("no local clone of %s found (git agent needs one; RCOI_TUI_ROOTS, see ?)" % t.repo)
            return False
        if not t.ref:
            self.notify("no agent/%s branch here yet (r: refresh)" % t.name)
            return False
        return True

    def act_new(self):
        m = self.m
        cur = self.current()
        repo = m.view
        if repo is None:
            repo = self.choose("new task in which repo?", m.repos, cur.repo if cur else m.here)
            if not repo:
                return
        if not valid_name(repo):
            return self.notify("bad repo name: %s" % repo)
        name = self.ask("new task in %s, name: " % repo)
        if not name:
            return
        if not valid_name(name):
            return self.notify("bad task name: %s (letters, digits, . _ -)" % name)
        if any(t.key == (repo, name) for t in m.tasks):
            return self.notify("%s already exists (u: start it, s: send to it)" % name)
        profile = self.ask("profile (empty: the default): ")
        if profile is None:
            return
        profile = profile.strip()
        if profile and not valid_name(profile):
            return self.notify("bad profile name: %s" % profile)
        prompt = self.ask("prompt (empty: just start it): ")
        if prompt is None:
            return
        opts = (["--profile", profile] if profile else []) + ["--bg"] + (["-p", prompt] if prompt.strip() else [])
        clone = m.clones.get(repo)
        if clone:
            cmd = GIT_AGENT + ["new", name] + opts       # pushes main first if it's ahead
        else:
            cmd = RCOI + ["task", "new", repo, name] + opts
        m.start_action("new %s" % name, [cmd], cwd=clone)

    def act_restart(self, t):
        if self.confirm("%s's agent is gone (container %s still up). restart it?" % (t.name, t.session[0])):
            self.m.start_action("restart %s" % t.name, [RCOI + ["task", "stop", t.repo, t.name],
                                                       RCOI + ["task", "shell", t.repo, t.name, "--bg"]])

    def act_wip(self, t):
        if not t.worktree:
            return self.notify("no worktree for %s on the host" % t.name)
        self.notify("wip %s ..." % t.name, True)
        self.draw()
        cmd = RCOI + ["task", "wip", t.repo, t.name]
        rc, out = run(cmd, timeout=60)
        lines = [clean(l) for l in out.splitlines()] or ["(no uncommitted changes)"]
        self.notify("" if rc == 0 else "wip %s failed (exit %d)" % (t.name, rc), rc == 0)
        self.view("uncommitted in %s (%s)" % (t.name, shown(cmd)), lines)

    def act_start(self, t):
        if t.gone:
            return self.act_restart(t)
        if t.session:
            return self.notify("%s is already running (s: send, a: attach)" % t.name)
        if not t.worktree:
            return self.notify("no worktree for %s on the host" % t.name)
        prompt = self.ask("start %s, prompt (empty: none): " % t.name)
        if prompt is None:
            return
        cmd = RCOI + ["task", "shell", t.repo, t.name, "--bg"] + (["-p", prompt] if prompt.strip() else [])
        self.m.start_action("start %s" % t.name, [cmd])

    def act_send(self, t):
        if t.gone:
            return self.notify("%s's agent is gone (u: restart it)" % t.name)
        if not t.session:
            return self.notify("%s has no running session (u: start one)" % t.name)
        text = self.ask("send to %s: " % t.name)
        if text and text.strip():
            self.m.start_action("send to %s" % t.name, [RCOI + ["task", "send", t.repo, t.name, text]])

    def act_attach(self, t):
        if t.gone:
            self.act_restart(t)
        elif t.session:
            self.interactive(RCOI + ["task", "attach", t.repo, t.name])
        elif t.worktree:
            # No session: an interactive one, which reattaches next time.
            if self.confirm("no session for %s; start an interactive one?" % t.name):
                self.interactive(RCOI + ["task", "shell", t.repo, t.name])
        else:
            self.notify("no worktree for %s on the host" % t.name)

    def act_key(self, ch):
        m = self.m
        if ch == "n":
            return self.act_new()
        if ch == "y":
            cur = self.current()
            repo = m.view or (cur.repo if cur else None)
            if not repo or repo not in m.clones:
                return self.notify("no local clone of %s found" % repo if repo else "no repo selected")
            if self.confirm("push %s's local %s to the agent host?" % (repo, BASE)):
                m.start_action("sync %s %s" % (repo, BASE), [GIT_AGENT + ["sync"]], cwd=m.clones[repo])
            return
        t = self.need_task()
        if t is None:
            return
        if ch in ("a", "\n", "\r", curses.KEY_ENTER):
            self.act_attach(t)
        elif ch == "s":
            self.act_send(t)
        elif ch == "u":
            self.act_start(t)
        elif ch == "x":
            if not t.session:
                return self.notify("%s has no running session" % t.name)
            if self.confirm("stop %s's session (the worktree stays)?" % t.name):
                m.start_action("stop %s" % t.name, [RCOI + ["task", "stop", t.repo, t.name]])
        elif ch in ("d", "l"):
            if self.need_local(t):
                self.interactive(GIT_AGENT + ["diff" if ch == "d" else "log", t.name], cwd=t.clone)
        elif ch == "t":
            if self.need_local(t) and self.confirm("check out agent/%s as review/%s (runs nothing yet)?" % (t.name, t.name)):
                m.start_action("try %s" % t.name, [GIT_AGENT + ["try", t.name]], cwd=t.clone)
        elif ch == "w":
            self.act_wip(t)
        elif ch == "c":
            if not t.worktree:
                return self.notify("no worktree for %s on the host" % t.name)
            msg = self.ask("commit everything in %s's worktree, message (empty: default): " % t.name)
            if msg is not None:
                m.start_action("commit %s" % t.name,
                               [RCOI + ["task", "commit", t.repo, t.name] + ([msg] if msg.strip() else [])])
        elif ch == "p":
            if self.need_local(t):
                m.start_action("pull %s" % t.name, [GIT_AGENT + ["pull", t.name]], cwd=t.clone)
        elif ch in ("P", "U"):
            if not self.need_local(t):
                return
            if not t.review:
                return self.notify("no review/%s here (t: try, p: pull)" % t.name)
            if ch == "P":
                if self.confirm("push review/%s to agent/%s on the host?" % (t.name, t.name)):
                    m.start_action("push %s" % t.name, [GIT_AGENT + ["push", t.name]], cwd=t.clone)
            elif self.confirm("merge local %s into review/%s and push it to the agent?" % (BASE, t.name)):
                m.start_action("update %s" % t.name, [GIT_AGENT + ["update", t.name]], cwd=t.clone)
        elif ch == "m":
            ahead = "" if t.ahead is None else " (+%d)" % t.ahead
            if self.need_local(t) and self.confirm("merge agent/%s%s into local %s?" % (t.name, ahead, BASE)):
                m.start_action("merge %s" % t.name, [GIT_AGENT + ["merge", t.name]], cwd=t.clone)
        elif ch == "D":
            local = bool(t.clone)
            q = "done %s: remove its worktree, session and branch on the host%s (merged work only)?" % (
                t.name, " and review/%s in %s" % (t.name, os.path.basename(t.clone)) if local else "")
            if self.confirm(q):
                cmd = GIT_AGENT + ["done", t.name] if local else RCOI + ["task", "done", t.repo, t.name]
                m.start_action("done %s" % t.name, [cmd], cwd=t.clone or None)
        elif ch == "X":
            local = bool(t.clone)
            lost = "" if t.ahead is None else " (%d commit(s) not in %s)" % (t.ahead, BASE)
            mine = " and review/%s in %s" % (t.name, os.path.basename(t.clone)) if local and t.review else ""
            if self.confirm("DROP %s%s: discard its branch, worktree and session%s?" % (t.name, lost, mine)):
                cmd = GIT_AGENT + ["drop", t.name, "-y"] if local else RCOI + ["task", "drop", t.repo, t.name, "-y"]
                m.start_action("drop %s" % t.name, [cmd], cwd=t.clone or None)

    def set_view(self, repo):
        """Show one repo's tasks (None: all), keeping the selected task if it's still shown."""
        m = self.m
        cur = self.current()
        with m.lock:
            m.view = repo
        tasks = m.visible()
        keys = [t.key for t in tasks]
        self.sel = keys.index(cur.key) if cur and cur.key in keys else 0
        self.top = 0
        m.wake_peek.set()

    def choose(self, title, items, current=None):
        """Pick one of items (j/k, Enter; Esc cancels; type to jump); None if cancelled."""
        if not items:
            self.notify("nothing to choose from yet (r: refresh)")
            return None
        sel = items.index(current) if current in items else 0
        while True:
            h, w = self.scr.getmaxyx()
            self.scr.erase()
            self.put(0, 0, (" %s " % title).ljust(w), curses.A_REVERSE | curses.A_BOLD)
            body = h - 2
            top = max(0, sel - body + 1)
            counts = {}
            for t in self.m.tasks:
                counts[t.repo] = counts.get(t.repo, 0) + 1
            for i, it in enumerate(items[top:top + body]):
                idx = top + i
                if it == "(all repos)":
                    n, mark = len(self.m.tasks), ""
                else:
                    n = counts.get(it, 0)
                    mark = self.m.clones.get(it, "(no local clone)")
                    if it == self.m.view:
                        mark += "   (shown now)"
                attr = curses.A_REVERSE if idx == sel else 0
                self.put(1 + i, 1, (" %-22s %3d task%s   %s" % (it, n, "" if n == 1 else "s", mark)).ljust(w - 2), attr)
            self.put(h - 1, 1, "j/k select   Enter choose   Esc cancel", self.c("dim"))
            self.scr.refresh()
            try:
                ch = self.scr.get_wch()
            except curses.error:
                continue
            if ch in ("\n", "\r", curses.KEY_ENTER):
                return items[sel]
            if ch in ("\x1b", "q"):
                return None
            if ch in ("j", curses.KEY_DOWN):
                sel = min(sel + 1, len(items) - 1)
            elif ch in ("k", curses.KEY_UP):
                sel = max(sel - 1, 0)
            elif isinstance(ch, str) and ch.isprintable():
                nxt = [i for i, it in enumerate(items) if it.lstrip("(").startswith(ch)]
                if nxt:
                    sel = next((i for i in nxt if i > sel), nxt[0])

    # -------------------------------------------------------------- main loop
    def loop(self):
        m = self.m
        while True:
            self.draw()
            try:
                ch = self.scr.get_wch()
            except curses.error:
                continue
            except KeyboardInterrupt:
                return
            n = len(m.visible())
            old = self.sel
            with m.lock:
                if not m.action and not m.status_ok:
                    m.status, m.status_ok = "", True
            if ch in ("q", "Q"):
                return
            elif ch in ("j", curses.KEY_DOWN):
                self.sel = min(self.sel + 1, max(n - 1, 0))
            elif ch in ("k", curses.KEY_UP):
                self.sel = max(self.sel - 1, 0)
            elif ch in ("g", curses.KEY_HOME):
                self.sel = 0
            elif ch in ("G", curses.KEY_END):
                self.sel = max(n - 1, 0)
            elif ch in ("v", " ", "\t"):
                cur = self.current()
                if cur is None:
                    self.notify("no task selected")
                else:
                    self.screen_view(cur, "changes" if ch == "\t" else None)
            elif ch == "A":
                cur = self.current()
                self.set_view(None if m.view else (cur.repo if cur else m.here))
            elif ch == "R":
                cur = self.current()
                # From one repo, start on "(all repos)"; from all, on the selected task's repo.
                pick = self.choose("show the tasks of (Enter: show, Esc: back)", ["(all repos)"] + m.repos,
                                   "(all repos)" if m.view else (cur.repo if cur else None))
                if pick:
                    self.set_view(None if pick == "(all repos)" else pick)
            elif ch == "r":
                self.notify("refreshing...", True)
                m.wake_list.set()
                m.wake_peek.set()
            elif ch == "o":
                with m.lock:
                    log = list(m.log)
                self.view("output (newest at the bottom)", log or ["(no commands run yet)"], follow=True)
            elif ch == "?":
                self.view("rcoi-tui help", HELP)
            elif ch == curses.KEY_RESIZE:
                pass
            else:
                self.act_key(ch)
            if self.sel != old:
                m.wake_peek.set()


def ssh_mux():
    """Share one SSH connection between all the rcoi and git calls.

    Returns a cleanup function. Every peek is an SSH login otherwise."""
    d = tempfile.mkdtemp(prefix="rcoi-", dir="/tmp")    # short: socket paths are limited
    opts = "-o ControlMaster=auto -o ControlPath=%s/%%C -o ControlPersist=60" % d
    os.environ["RCOI_SSH_OPTS"] = (os.environ.get("RCOI_SSH_OPTS", "") + " " + opts).strip()
    if not os.environ.get("GIT_SSH_COMMAND") and not git_out("config", "core.sshCommand"):
        os.environ["GIT_SSH_COMMAND"] = "ssh " + opts

    def cleanup(host):
        if host:
            run(["ssh", "-o", "ControlPath=%s/%%C" % d, "-O", "exit", host], timeout=5)
        shutil.rmtree(d, ignore_errors=True)
    return cleanup


def main(argv):
    all_repos, mux, interval = False, True, 2.0
    args = list(argv)
    while args:
        a = args.pop(0)
        if a in ("-a", "--all"):
            all_repos = True
        elif a == "--no-mux":
            mux = False
        elif a == "--interval" and args:
            try:
                interval = max(0.5, float(args.pop(0)))
            except ValueError:
                sys.exit("rcoi-tui: --interval needs a number of seconds")
        elif a in ("-h", "--help", "help"):
            print(__doc__.strip())
            return 0
        else:
            print(__doc__.strip().splitlines()[2], file=sys.stderr)
            return 2

    host = os.environ.get("RCOI_HOST", "")
    if not host and os.path.exists(CONF):
        with open(CONF) as f:
            host = f.readline().strip()
    if not host:
        sys.exit("rcoi-tui: no host: set RCOI_HOST or put user@host into %s (install.sh --host)" % CONF)

    # The repo we're in, by its name on the host (the local folder may be
    # named differently), and the local clones of the others.
    top = git_out("rev-parse", "--show-toplevel")
    here = (host_repo(top) or os.path.basename(top)) if top else None
    clones = find_clones(roots(top), top or None)

    cleanup = ssh_mux() if mux else None
    model = Model(host, here, clones, all_repos)
    threading.Thread(target=model.list_loop, daemon=True).start()
    threading.Thread(target=model.peek_loop, args=(interval,), daemon=True).start()

    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    try:
        curses.wrapper(lambda scr: UI(scr, model, interval).loop())
    except KeyboardInterrupt:
        pass
    finally:
        if cleanup:
            cleanup(host)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
