#!/usr/bin/env bash
# git agent - move code between this repo and the agent host over SSH.
# Run inside a repo on your machine. `git agent help` for the commands.
# Part of rcoi (install.sh installs both).
#
# The agent host is just a second git remote ("agentvm"): you push main to
# it, agents commit to agent/<task> branches there (rcoi task new), you fetch
# those back and review them here. Your other remotes (e.g. GitHub) only see
# what you push to them yourself.
set -euo pipefail

die() { echo "git agent: $*" >&2; exit 1; }

# Same host as rcoi: $AGENTVM_HOST, else $RCOI_HOST, else ~/.config/rcoi/host.
conf="${XDG_CONFIG_HOME:-$HOME/.config}/rcoi/host"
HOST=${AGENTVM_HOST:-${RCOI_HOST:-}}
if [[ -z $HOST && -r $conf ]]; then
  read -r HOST <"$conf" || true
fi
REMOTE=${AGENTVM_REMOTE:-agentvm}
BASE=${AGENTVM_BASE:-main}

usage() {
  cat <<EOF
usage: git agent <command> [task]

  init          create ~/src/<repo> on the agent host, add the '$REMOTE' remote, push $BASE
  connect       only add the '$REMOTE' remote, for a repo already on the agent host
                (init was run on another machine)
  remove [-y]   delete ~/src/<repo> and its tasks on the agent host, then the '$REMOTE' remote
                (asks first; unmerged agent branches there are lost)
  sync          push $BASE to the agent host (agents start new tasks from it)
  list          fetch and list the agent branches (newest first)
  diff <task>   what the agent changed since it branched off $BASE
  log  <task>   the same, commit by commit
  try  <task>   check it out as review/<task> (this runs the agent's code: read the diff first)
  merge <task>  merge it into $BASE (then: git push origin $BASE && git agent sync)

  <task> is the name given to 'rcoi task new <repo> <task>'.
  Host: ${HOST:-<not set>} (AGENTVM_HOST, RCOI_HOST or $conf).
  Env: AGENTVM_REMOTE ($REMOTE), AGENTVM_BASE ($BASE).
EOF
}

case ${1:-help} in help|-h|--help) usage; exit 0 ;; esac

top=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repo"
cd "$top"
repo=$(basename "$top")

need_remote() {
  git remote get-url "$REMOTE" >/dev/null 2>&1 || die "no '$REMOTE' remote here; run: git agent init"
}

branch() {
  [ -n "${1:-}" ] || die "missing task name (see: git agent list)"
  [[ $1 =~ ^[A-Za-z0-9._-]+$ ]] || die "bad task name: $1"
  need_remote
  git fetch -q --prune "$REMOTE"
  local ref="refs/remotes/$REMOTE/agent/$1"
  git rev-parse -q --verify "$ref" >/dev/null || die "no branch agent/$1 on the agent host (see: git agent list)"
  echo "$REMOTE/agent/$1"
}

cmd=${1:-help}
shift || true

# Checks shared by init and connect.
precheck() {
  [[ $repo =~ ^[A-Za-z0-9._-]+$ && $repo != .* ]] || die "repo dir name '$repo' is not a safe name"
  git remote get-url "$REMOTE" >/dev/null 2>&1 && die "remote '$REMOTE' already exists: $(git remote get-url "$REMOTE")"
  [[ -n $HOST ]] || die "no agent host: put user@host into $conf (or set RCOI_HOST)"
}

add_remote() {
  git remote add "$REMOTE" "$HOST:src/$repo"
  # Fetch only the agent branches: agents could move other refs in the host's
  # repo (e.g. main), and those should never show up here.
  git config "remote.$REMOTE.fetch" "+refs/heads/agent/*:refs/remotes/$REMOTE/agent/*"
}

case $cmd in
  init)
    precheck
    git rev-parse -q --verify "refs/heads/$BASE" >/dev/null || die "no local branch $BASE to push"
    # coi-task (on the agent host) makes ~/src/<repo> accept pushes to its
    # checked-out main.
    # shellcheck disable=SC2029  # expands here on purpose; $repo is validated above
    ssh "$HOST" coi-task init "$repo" || die "init on the agent host failed (if ~/src/$repo is already there from another machine: git agent connect)"
    add_remote
    git push -q "$REMOTE" "$BASE"
    echo "ready: rcoi task new $repo <task> --bg -p \"<prompt>\""
    ;;
  connect)
    precheck
    # Nothing is created or pushed: just check the host's repo is there.
    git ls-remote -q --exit-code "$HOST:src/$repo" "refs/heads/$BASE" >/dev/null \
      || die "no $BASE in src/$repo on $HOST (new repo there? use: git agent init)"
    add_remote
    git fetch -q "$REMOTE"
    # Tell how this main relates to the host's, so sync doesn't surprise.
    host_base=$(git ls-remote -q "$REMOTE" "refs/heads/$BASE" | cut -f1)
    if ! git rev-parse -q --verify "refs/heads/$BASE" >/dev/null; then
      note="no local $BASE yet"
    elif [[ $(git rev-parse "refs/heads/$BASE") == "$host_base" ]]; then
      note="$BASE matches the agent host"
    elif git merge-base --is-ancestor "$host_base" "refs/heads/$BASE" 2>/dev/null; then
      note="$BASE is ahead of the agent host: git agent sync"
    elif git merge-base --is-ancestor "refs/heads/$BASE" "$host_base" 2>/dev/null; then
      note="$BASE is behind the agent host: git pull origin $BASE"
    else
      note="$BASE differs from the agent host's ($(git rev-parse --short "$host_base" 2>/dev/null || echo "${host_base:0:7}")) - pull it from origin first, then git agent sync"
    fi
    echo "connected to $HOST:src/$repo ($note)"
    "$0" list
    ;;
  remove)
    [[ $# -eq 0 || ( $# -eq 1 && $1 == -y ) ]] || die "usage: git agent remove [-y]"
    [[ $repo =~ ^[A-Za-z0-9._-]+$ && $repo != .* ]] || die "repo dir name '$repo' is not a safe name"
    [[ -n $HOST ]] || die "no agent host: put user@host into $conf (or set RCOI_HOST)"
    target="$HOST:src/$repo"
    if url=$(git remote get-url "$REMOTE" 2>/dev/null) && [[ $url != "$target" ]]; then
      die "remote '$REMOTE' is $url, not $target - remove it by hand"
    fi
    # A terminal for coi-task's confirmation prompt (unless -y).
    if [[ -t 0 && -t 1 ]]; then tty=-t; else tty=-T; fi
    # shellcheck disable=SC2029  # expands here on purpose; $repo is validated above
    ssh "$tty" -o LogLevel=ERROR "$HOST" coi-task remove "$repo" "$@" \
      || die "nothing removed here (already gone from the host? then just: git remote remove $REMOTE)"
    if git remote get-url "$REMOTE" >/dev/null 2>&1; then
      git remote remove "$REMOTE"
      echo "removed the '$REMOTE' remote"
    fi
    ;;
  sync)
    # Plain push, never forced: if it's rejected, main on the agent host was moved
    # (by an agent?) - look before you overwrite it.
    need_remote
    git push "$REMOTE" "$BASE"
    ;;
  list)
    need_remote
    git fetch -q --prune "$REMOTE"
    out=$(git for-each-ref --sort=-committerdate \
            --format='%(refname:lstrip=4)%09%(committerdate:relative)%09%(subject)' \
            "refs/remotes/$REMOTE/agent/")
    if [ -z "$out" ]; then echo "no agent branches on the agent host"; else column -t -s $'\t' <<<"$out"; fi
    ;;
  diff)
    b=$(branch "${1:-}"); git diff "$BASE...$b"
    ;;
  log)
    b=$(branch "${1:-}"); git log -p "$BASE..$b"
    ;;
  try)
    b=$(branch "${1:-}"); git switch -c "review/$1" "$b"
    ;;
  merge)
    b=$(branch "${1:-}")
    git switch -q "$BASE"
    git merge --no-ff -m "Merge agent/$1" "$b"
    echo "next: git push origin $BASE && git agent sync && rcoi task done $repo $1"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2; exit 2
    ;;
esac
