#!/usr/bin/env bash
# git agent - move code between this repo and the agent host over SSH.
# Run inside a repo on your machine. `git agent help` for the commands.
# Part of rcoi (install.sh installs both).
#
# The agent host is just a second git remote ("agentvm"): you push main to
# it, agents commit to agent/<task> branches there (rcoi task new), you fetch
# those back and review them here. Your other remotes (e.g. GitHub) only see
# what you push to them yourself.
set -euo pipefail

die() { echo "git agent: $*" >&2; exit 1; }

# Same host as rcoi: $AGENTVM_HOST, else $RCOI_HOST, else ~/.config/rcoi/host.
conf="${XDG_CONFIG_HOME:-$HOME/.config}/rcoi/host"
HOST=${AGENTVM_HOST:-${RCOI_HOST:-}}
if [[ -z $HOST && -r $conf ]]; then
  read -r HOST <"$conf" || true
fi
REMOTE=${AGENTVM_REMOTE:-agentvm}
BASE=${AGENTVM_BASE:-main}

usage() {
  cat <<EOF
usage: git agent <command> [task]

  init          create ~/src/<repo> on the agent host, add the '$REMOTE' remote, push $BASE
  connect       only add the '$REMOTE' remote, for a repo already on the agent host
                (init was run on another machine)
  remove [-y]   delete ~/src/<repo> and its tasks on the agent host, then the '$REMOTE' remote
                (asks first; unmerged agent branches there are lost)
  sync          push $BASE to the agent host (agents start new tasks from it)
  new <task> [--no-sync] [--profile P] [mode]
                rcoi task new <repo> <task> ... for this repo (mode: --bg [-p "..."],
                -p "...", see rcoi task help); pushes $BASE first if it's ahead of the host's
  list          fetch and list the agent branches (newest first), flagging those with
                nothing new vs $BASE or uncommitted changes in the host's worktree
  wip  [task]   the agent's uncommitted changes in its worktree on the host
                (commit them there: rcoi task commit <repo> <task>)
  diff <task>   what the agent changed since it branched off $BASE
  log  <task>   the same, commit by commit
  try  <task>   check it out as review/<task> (this runs the agent's code: read the diff first);
                again later: switch to it and fast-forward it to the agent's new commits
  pull [task]   bring the agent's new commits into review/<task> (creates it if missing)
  push [task]   send your commits on review/<task> to agent/<task> on the agent host,
                so the agent continues from them (never forced: pull first if it moved)
  update [task] merge your $BASE into review/<task> and push it, so the agent works on top
                of the newer code
  merge <task>  merge it into $BASE: review/<task> if it has your commits on top of the
                agent's, else agent/<task> (then: git push origin $BASE && git agent done)
  done [task]   after merge: push $BASE to the host, remove the task there (worktree,
                session, agent/<task>) and review/<task> here; refuses unmerged work
  drop [task] [-y]
                discard a task, merged or not: the same removal, after asking

  <task> is the name given to 'git agent new' / 'rcoi task new <repo> <task>';
  where it's optional, it defaults to the task of the current review/<task> branch.
  Host: ${HOST:-<not set>} (AGENTVM_HOST, RCOI_HOST or $conf).
  Env: AGENTVM_REMOTE ($REMOTE), AGENTVM_BASE ($BASE).
EOF
}

case ${1:-help} in help|-h|--help) usage; exit 0 ;; esac

top=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repo"
cd "$top"
repo=$(basename "$top")

# The repo's name and host on the agent host come from the '$REMOTE' remote
# (user@host:src/<name>) once there is one; before that, from this dir and $HOST.
hrepo=$repo rhost=$HOST
if url=$(git remote get-url "$REMOTE" 2>/dev/null) && [[ $url == ?*:?* && $url != *://* ]]; then
  rhost=${url%%:*}; hrepo=$(basename "${url#*:}")
fi

# Run coi-task on the agent host: coi_task [-t] <args...>
# (-t: a terminal for it, when we have one). Every argument arrives as given.
coi_task() {
  local tty=-T cmd
  if [[ ${1:-} == -t ]]; then
    shift
    if [[ -t 0 && -t 1 ]]; then tty=-t; fi
  fi
  [[ -n $rhost ]] || die "no agent host: put user@host into $conf (or set RCOI_HOST)"
  printf -v cmd '%q ' coi-task "$@"
  # shellcheck disable=SC2029  # quoted above with %q, for the remote shell
  ssh "$tty" -o LogLevel=ERROR "$rhost" "$cmd"
}

valid_task() {
  [[ $1 =~ ^[A-Za-z0-9._-]+$ ]] || die "bad task name: $1"
}

on_branch() { [[ $(git symbolic-ref -q --short HEAD || true) == "$1" ]]; }

need_remote() {
  git remote get-url "$REMOTE" >/dev/null 2>&1 || die "no '$REMOTE' remote here; run: git agent init"
}

branch() {
  [ -n "${1:-}" ] || die "missing task name (see: git agent list)"
  [[ $1 =~ ^[A-Za-z0-9._-]+$ ]] || die "bad task name: $1"
  need_remote
  git fetch -q --prune "$REMOTE"
  local ref="refs/remotes/$REMOTE/agent/$1"
  git rev-parse -q --verify "$ref" >/dev/null || die "no branch agent/$1 on the agent host (see: git agent list)"
  echo "$REMOTE/agent/$1"
}

# The task for pull/push: the argument, else the current review/<task> branch.
task_arg() {
  if [ -n "${1:-}" ]; then echo "$1"; return; fi
  local cur; cur=$(git symbolic-ref -q --short HEAD || true)
  [[ $cur == review/?* ]] || die "missing task name (or run it on a review/<task> branch)"
  echo "${cur#review/}"
}

# Of the given tasks, those whose worktree on the agent host (<repo path>-<task>,
# next to the repo, as coi-task makes them) has uncommitted changes, one per
# line. Best effort: prints nothing if the host can't be asked.
dirty_tasks() {
  local url host path t q=() cmd
  url=$(git remote get-url "$REMOTE" 2>/dev/null) || return 0
  [[ $url == ?*:?* && $url != *://* ]] || return 0    # only user@host:path remotes
  host=${url%%:*} path=${url#*:}
  for t in "$@"; do [[ $t =~ ^[A-Za-z0-9._-]+$ ]] && q+=("$t"); done
  ((${#q[@]})) || return 0
  # %q quotes every word for the remote shell (bash, as for rcoi).
  printf -v cmd '%q ' "$path" "${q[@]}"
  # shellcheck disable=SC2016  # $p, $t and $(...) are for the remote shell
  ssh -n -o LogLevel=ERROR -o BatchMode=yes -o ConnectTimeout=5 "$host" \
    "set -- $cmd"'; p=$1; shift
     for t; do [ -n "$(git -C "$p-$t" status --porcelain 2>/dev/null)" ] && echo "$t"; done; true' \
    2>/dev/null || true
}

# What says a task isn't ready to review, comma separated (empty: nothing).
# task_notes <task> <remote ref> <output of dirty_tasks>
task_notes() {
  local n=()
  # No commits beyond main: the agent hasn't committed (or it's merged already).
  if git merge-base --is-ancestor "$2" "refs/heads/$BASE" 2>/dev/null; then
    n+=("nothing new vs $BASE")
  fi
  if grep -qxF -- "$1" <<<"$3"; then n+=("uncommitted changes on the host"); fi
  local s="" x
  for x in ${n[@]+"${n[@]}"}; do s+="${s:+, }$x"; done
  echo "$s"
}

# Warn (stderr) before checking out a task that looks unfinished.
warn_task() {   # warn_task <task> <remote ref>
  local notes; notes=$(task_notes "$1" "$2" "$(dirty_tasks "$1")")
  [[ -n $notes ]] || return 0
  echo "git agent: warning: agent/$1: $notes" >&2
  echo "git agent: the agent may not be done, or didn't commit - check: rcoi task peek $hrepo $1" >&2
  echo "git agent: its uncommitted work: git agent wip $1; commit it: rcoi task commit $hrepo $1" >&2
  echo "git agent: (or ask it: rcoi task send $hrepo $1 'commit your work to the current branch')" >&2
}

cmd=${1:-help}
shift || true

# Checks shared by init and connect.
precheck() {
  [[ $repo =~ ^[A-Za-z0-9._-]+$ && $repo != .* ]] || die "repo dir name '$repo' is not a safe name"
  git remote get-url "$REMOTE" >/dev/null 2>&1 && die "remote '$REMOTE' already exists: $(git remote get-url "$REMOTE")"
  [[ -n $HOST ]] || die "no agent host: put user@host into $conf (or set RCOI_HOST)"
}

add_remote() {
  git remote add "$REMOTE" "$HOST:src/$repo"
  # Fetch only the agent branches: agents could move other refs in the host's
  # repo (e.g. main), and those should never show up here.
  git config "remote.$REMOTE.fetch" "+refs/heads/agent/*:refs/remotes/$REMOTE/agent/*"
}

case $cmd in
  init)
    precheck
    git rev-parse -q --verify "refs/heads/$BASE" >/dev/null || die "no local branch $BASE to push"
    # coi-task (on the agent host) makes ~/src/<repo> accept pushes to its
    # checked-out main.
    # shellcheck disable=SC2029  # expands here on purpose; $repo is validated above
    ssh "$HOST" coi-task init "$repo" || die "init on the agent host failed (if ~/src/$repo is already there from another machine: git agent connect)"
    add_remote
    git push -q "$REMOTE" "$BASE"
    echo "ready: rcoi task new $repo <task> --bg -p \"<prompt>\""
    ;;
  connect)
    precheck
    # Nothing is created or pushed: just check the host's repo is there.
    git ls-remote -q --exit-code "$HOST:src/$repo" "refs/heads/$BASE" >/dev/null \
      || die "no $BASE in src/$repo on $HOST (new repo there? use: git agent init)"
    add_remote
    git fetch -q "$REMOTE"
    # Tell how this main relates to the host's, so sync doesn't surprise.
    host_base=$(git ls-remote -q "$REMOTE" "refs/heads/$BASE" | cut -f1)
    if ! git rev-parse -q --verify "refs/heads/$BASE" >/dev/null; then
      note="no local $BASE yet"
    elif [[ $(git rev-parse "refs/heads/$BASE") == "$host_base" ]]; then
      note="$BASE matches the agent host"
    elif git merge-base --is-ancestor "$host_base" "refs/heads/$BASE" 2>/dev/null; then
      note="$BASE is ahead of the agent host: git agent sync"
    elif git merge-base --is-ancestor "refs/heads/$BASE" "$host_base" 2>/dev/null; then
      note="$BASE is behind the agent host: git pull origin $BASE"
    else
      note="$BASE differs from the agent host's ($(git rev-parse --short "$host_base" 2>/dev/null || echo "${host_base:0:7}")) - pull it from origin first, then git agent sync"
    fi
    echo "connected to $HOST:src/$repo ($note)"
    "$0" list
    ;;
  remove)
    [[ $# -eq 0 || ( $# -eq 1 && $1 == -y ) ]] || die "usage: git agent remove [-y]"
    [[ $repo =~ ^[A-Za-z0-9._-]+$ && $repo != .* ]] || die "repo dir name '$repo' is not a safe name"
    [[ -n $HOST ]] || die "no agent host: put user@host into $conf (or set RCOI_HOST)"
    target="$HOST:src/$repo"
    if url=$(git remote get-url "$REMOTE" 2>/dev/null) && [[ $url != "$target" ]]; then
      die "remote '$REMOTE' is $url, not $target - remove it by hand"
    fi
    # An older coi-task answers an unknown command with its help (and exit 1),
    # which would look like "repo not there"; say what's actually wrong.
    ssh -o LogLevel=ERROR "$HOST" coi-task help 2>/dev/null | grep -q 'coi-task remove' \
      || die "coi-task on $HOST has no 'remove' (too old, or unreachable): update it there with ./install.sh --agent-host"
    # A terminal for coi-task's confirmation prompt (unless -y).
    if [[ -t 0 && -t 1 ]]; then tty=-t; else tty=-T; fi
    # shellcheck disable=SC2029  # expands here on purpose; $repo is validated above
    ssh "$tty" -o LogLevel=ERROR "$HOST" coi-task remove "$repo" "$@" \
      || die "removing on $HOST failed or was cancelled (see above); the '$REMOTE' remote is kept"
    if git remote get-url "$REMOTE" >/dev/null 2>&1; then
      git remote remove "$REMOTE"
      echo "removed the '$REMOTE' remote"
    fi
    ;;
  sync)
    # Plain push, never forced: if it's rejected, main on the agent host was moved
    # (by an agent?) - look before you overwrite it.
    need_remote
    git push "$REMOTE" "$BASE"
    ;;
  list)
    need_remote
    git fetch -q --prune "$REMOTE"
    out=$(git for-each-ref --sort=-committerdate \
            --format='%(refname:lstrip=4)%09%(committerdate:relative)%09%(subject)' \
            "refs/remotes/$REMOTE/agent/")
    if [ -z "$out" ]; then echo "no agent branches on the agent host"; exit 0; fi
    # One ssh call for all tasks, then a 4th column with what's not ready.
    # shellcheck disable=SC2046  # task names are [A-Za-z0-9._-], split on purpose
    dirty=$(dirty_tasks $(cut -f1 <<<"$out"))
    while IFS=$'\t' read -r t when subject; do
      notes=$(task_notes "$t" "refs/remotes/$REMOTE/agent/$t" "$dirty")
      printf '%s\t%s\t%s\t%s\n' "$t" "$when" "$subject" "${notes:+! $notes}"
    done <<<"$out" | column -t -s $'\t'
    ;;
  diff)
    b=$(branch "${1:-}"); git diff "$BASE...$b"
    ;;
  log)
    b=$(branch "${1:-}"); git log -p "$BASE..$b"
    ;;
  try)
    b=$(branch "${1:-}"); lb="review/$1"
    warn_task "$1" "$b"
    if ! git rev-parse -q --verify "refs/heads/$lb" >/dev/null; then
      git switch -c "$lb" "$b"
      exit 0
    fi
    # Tried before: switch to it and bring in the agent's new commits, but
    # only by fast-forward - your own commits there are for 'git agent pull'.
    git switch -q "$lb"
    if git merge-base --is-ancestor "$b" HEAD; then
      echo "on $lb, up to date with $b"
    elif git merge-base --is-ancestor HEAD "$b"; then
      git merge -q --ff-only "$b"
      echo "on $lb, fast-forwarded to $b"
    else
      die "on $lb, which has commits of its own; bring in the agent's new ones with: git agent pull $1"
    fi
    ;;
  pull)
    # Bring the agent's work (or what you pushed from another machine) into
    # review/<task>. Merges, never rebases: the agent's history stays as it is.
    [[ $# -le 1 ]] || die "usage: git agent pull [task]"
    task=$(task_arg "${1:-}")
    b=$(branch "$task")
    lb="review/$task"
    cur=$(git symbolic-ref -q --short HEAD || true)
    if ! git rev-parse -q --verify "refs/heads/$lb" >/dev/null; then
      git branch -q "$lb" "$b"
      echo "created $lb from $b (git switch $lb)"
    elif git merge-base --is-ancestor "$b" "refs/heads/$lb"; then
      echo "$lb already has everything from $b"
    elif [[ $cur == "$lb" ]]; then
      git merge -m "Merge $b into $lb" "$b"
    elif git merge-base --is-ancestor "refs/heads/$lb" "$b"; then
      git branch -q -f "$lb" "$b"
      echo "fast-forwarded $lb to $b"
    else
      die "$lb and $b have both moved on; merge them on the branch: git switch $lb && git agent pull"
    fi
    ;;
  push)
    # Your commits on review/<task> become the agent's branch. The host updates
    # the task worktree's files too, and refuses if the agent has uncommitted
    # changes there. Never forced: if the agent committed meanwhile, pull first.
    [[ $# -le 1 ]] || die "usage: git agent push [task]"
    task=$(task_arg "${1:-}")
    lb="review/$task"
    git rev-parse -q --verify "refs/heads/$lb" >/dev/null || die "no local branch $lb (create it: git agent pull $task)"
    b=$(branch "$task")    # only existing tasks: a new branch there would have no worktree
    if git merge-base --is-ancestor "refs/heads/$lb" "$b"; then
      echo "nothing to push: $b already has everything from $lb"; exit 0
    fi
    if ! git merge-base --is-ancestor "$b" "refs/heads/$lb"; then
      die "the agent committed to agent/$task since you last pulled: git agent pull $task, then push again"
    fi
    if [[ $(git symbolic-ref -q --short HEAD || true) == "$lb" && -n $(git status --porcelain --untracked-files=no) ]]; then
      echo "note: uncommitted changes in $lb are not pushed" >&2
    fi
    git push "$REMOTE" "refs/heads/$lb:refs/heads/agent/$task" \
      || die "push refused (above). 'Working directory has ... changes': the agent has uncommitted work in its worktree - let it commit (or stop it), then push again"
    echo "pushed $lb to agent/$task; a running agent doesn't know yet - tell it, e.g.:"
    echo "  rcoi task send $hrepo $task 'I pushed new commits to your branch (git log); continue from them'"
    ;;
  update)
    # Bring newer $BASE into a task: agent's commits -> review/<task>, merge
    # $BASE there, push it back for the agent to continue from.
    [[ $# -le 1 ]] || die "usage: git agent update [task]"
    task=$(task_arg "${1:-}")
    b=$(branch "$task"); lb="review/$task"
    git rev-parse -q --verify "refs/heads/$BASE" >/dev/null || die "no local branch $BASE"
    if git rev-parse -q --verify "refs/heads/$lb" >/dev/null; then
      git switch -q "$lb"; "$0" pull "$task"
    else
      "$0" pull "$task"; git switch -q "$lb"
    fi
    if git merge-base --is-ancestor "refs/heads/$BASE" HEAD; then
      echo "$lb already has everything from $BASE"
    else
      git merge -m "Merge $BASE into $lb" "$BASE" \
        || die "resolve the conflicts on $lb, git commit, then: git agent push $task"
    fi
    "$0" push "$task"
    ;;
  wip)
    # The agent's uncommitted changes, straight from its worktree on the host.
    [[ $# -le 1 ]] || die "usage: git agent wip [task]"
    task=$(task_arg "${1:-}"); valid_task "$task"; need_remote
    if [[ -t 1 ]]; then
      coi_task wip "$hrepo" "$task" --color | LESS=${LESS-FRX} sh -c "$(git var GIT_PAGER)"
    else
      coi_task wip "$hrepo" "$task"
    fi
    ;;
  new)
    # rcoi task new for this repo, after making sure the task starts from your
    # $BASE: pushed first when it's ahead of the host's (a fast-forward only).
    [[ $# -ge 1 && $1 != -* ]] || die "usage: git agent new <task> [--no-sync] [--profile P] [mode]"
    task=$1; shift; valid_task "$task"; need_remote
    dosync=1
    if [[ ${1:-} == --no-sync ]]; then dosync=0; shift; fi
    if git rev-parse -q --verify "refs/heads/$BASE" >/dev/null; then
      host_base=$(git ls-remote -q "$REMOTE" "refs/heads/$BASE" | cut -f1)
      if [[ -z $host_base || $host_base == "$(git rev-parse "refs/heads/$BASE")" ]]; then
        :
      elif git merge-base --is-ancestor "$host_base" "refs/heads/$BASE" 2>/dev/null; then
        if ((dosync)); then
          echo "git agent: your $BASE is ahead of the agent host's - pushing it first (--no-sync: don't)" >&2
          git push -q "$REMOTE" "$BASE"
        else
          echo "git agent: note: the task starts from the host's $BASE, which is behind yours" >&2
        fi
      else
        echo "git agent: warning: $BASE on the agent host differs from yours (not a fast-forward) - the task starts from the host's" >&2
      fi
    fi
    coi_task -t new "$hrepo" "$task" "$@"
    ;;
  merge)
    # Merge review/<task> when it has your commits on top of the agent's
    # (merging only agent/<task> would leave them out), else agent/<task>.
    [[ $# -eq 1 ]] || die "usage: git agent merge <task>"
    b=$(branch "$1"); lb="review/$1"; src=$b
    warn_task "$1" "$b"
    if git rev-parse -q --verify "refs/heads/$lb" >/dev/null; then
      if git merge-base --is-ancestor "refs/heads/$lb" "$b"; then
        :    # nothing of your own there
      elif git merge-base --is-ancestor "$b" "refs/heads/$lb"; then
        src=$lb
        echo "merging $lb: it has your commits on top of agent/$1"
      else
        die "$lb and agent/$1 have both moved on: git agent pull $1 first, then merge again"
      fi
      if on_branch "$lb" && [[ -n $(git status --porcelain --untracked-files=no) ]]; then
        die "uncommitted changes on $lb - commit them (they'd be left out) or stash them first"
      fi
    fi
    git switch -q "$BASE"
    git merge --no-ff -m "Merge agent/$1" "$src"
    echo "next: git push origin $BASE && git agent done $1"
    ;;
  done)
    # After merge: sync $BASE, remove the task on the host (coi-task done),
    # delete review/<task> here. Merged work only - see drop.
    [[ $# -le 1 ]] || die "usage: git agent done [task]"
    task=$(task_arg "${1:-}"); valid_task "$task"; need_remote
    lb="review/$task" rb="refs/remotes/$REMOTE/agent/$task"
    git fetch -q --prune "$REMOTE"
    git rev-parse -q --verify "refs/heads/$BASE" >/dev/null || die "no local branch $BASE"
    git rev-parse -q --verify "$rb" >/dev/null || git rev-parse -q --verify "refs/heads/$lb" >/dev/null \
      || die "no task $task: no agent/$task on the agent host and no $lb here"
    for r in "$rb" "refs/heads/$lb"; do
      if git rev-parse -q --verify "$r" >/dev/null && ! git merge-base --is-ancestor "$r" "refs/heads/$BASE"; then
        die "${r#refs/*/} is not merged into $BASE - nothing removed (git agent merge $task, or discard it: git agent drop $task)"
      fi
    done
    # The host only removes a branch its own $BASE contains.
    git push -q "$REMOTE" "$BASE" \
      || die "pushing $BASE to the agent host was refused (its $BASE moved?) - nothing removed"
    coi_task done "$hrepo" "$task" || die "removing the task on the agent host failed (above) - local branches kept"
    if git rev-parse -q --verify "refs/heads/$lb" >/dev/null; then
      if on_branch "$lb"; then git switch -q "$BASE"; fi
      git branch -q -D "$lb"    # merged into $BASE, checked above
      echo "deleted $lb"
    fi
    git fetch -q --prune "$REMOTE"
    echo "done: $task (if you haven't yet: git push origin $BASE)"
    ;;
  drop)
    # Discard a task: the agent's branch, its worktree and session on the host,
    # and review/<task> here. Asks first (unless -y).
    yes=0 args=()
    for a in "$@"; do if [[ $a == -y ]]; then yes=1; else args+=("$a"); fi; done
    [[ ${#args[@]} -le 1 ]] || die "usage: git agent drop [task] [-y]"
    task=$(task_arg "${args[0]:-}"); valid_task "$task"; need_remote
    lb="review/$task" rb="refs/remotes/$REMOTE/agent/$task"
    git fetch -q --prune "$REMOTE"
    has_rb=0 has_lb=0
    git rev-parse -q --verify "$rb" >/dev/null && has_rb=1
    git rev-parse -q --verify "refs/heads/$lb" >/dev/null && has_lb=1
    ((has_rb || has_lb)) || die "nothing to drop: no agent/$task on the agent host and no $lb here"
    if ((!yes)); then
      [[ -t 0 ]] || die "not a terminal: add -y to confirm"
      what=()
      if ((has_rb)); then
        n=$(git rev-list --count "$rb" --not "refs/heads/$BASE" 2>/dev/null || git rev-list --count "$rb")
        d=""; [[ -n $(dirty_tasks "$task") ]] && d=", uncommitted changes"
        what+=("agent/$task and its session on the host ($n commit(s) not in $BASE$d)")
      fi
      if ((has_lb)); then
        excl=("refs/heads/$BASE"); ((has_rb)) && excl+=("$rb")
        n=$(git rev-list --count "refs/heads/$lb" --not "${excl[@]}")
        what+=("$lb here ($n commit(s) of your own)")
      fi
      printf 'Discard:\n'; printf '  %s\n' "${what[@]}"
      read -r -p "[y/N] " ans
      [[ $ans == [yY]* ]] || die "nothing removed"
    fi
    if ((has_rb)); then
      coi_task drop "$hrepo" "$task" -y || die "dropping on the agent host failed (above) - local branches kept"
    fi
    if ((has_lb)); then
      if on_branch "$lb"; then git switch -q "$BASE"; fi
      git branch -q -D "$lb"
      echo "deleted $lb"
    fi
    git fetch -q --prune "$REMOTE"
    echo "dropped: $task"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2; exit 2
    ;;
esac
